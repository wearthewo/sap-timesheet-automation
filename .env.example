# Copy to .env and fill all blank secrets with independently generated values.
# Do not commit .env. Example generation: openssl rand -hex 32
DATABASE_URL=jdbc:postgresql://localhost:5432/workforce
DATABASE_USERNAME=workforce
DATABASE_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
NEXTAUTH_SECRET=
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/workforce
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/workforce/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=workforce-api
KEYCLOAK_CLIENT_ID=workforce-web
KEYCLOAK_INTERNAL_URL=http://localhost:8180/realms/workforce
KEYCLOAK_PUBLIC_URL=http://localhost:8180
FRONTEND_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180
BACKEND_PORT=8080
FRONTEND_PORT=3000

MAX_DAILY_HOURS=24

# Local mock SAP token: generate a separate development-only secret.
SAP_API_TOKEN=
# Compose default is http://mock-sap:8090. Set an accessible URL when running backend outside Compose.
SAP_BASE_URL=http://mock-sap:8090
SAP_CONNECT_TIMEOUT=2s
SAP_RESPONSE_TIMEOUT=5s
# Must exceed SAP connect + response timeout, allowing time for database updates.
SAP_EXPORT_REQUEST_TIMEOUT_MS=20000
