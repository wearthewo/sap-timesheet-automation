# Copy to .env and fill all blank secrets with independently generated values.
# Do not commit .env. Example generation: openssl rand -hex 32
DATABASE_URL=jdbc:postgresql://localhost:5432/workforce
DATABASE_USERNAME=workforce
DATABASE_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
NEXTAUTH_SECRET=
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/workforce
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/workforce/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=workforce-api
KEYCLOAK_CLIENT_ID=workforce-web
KEYCLOAK_INTERNAL_URL=http://localhost:8180/realms/workforce
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Identity verification/recovery mail (separate from Workforce business notifications).
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=accounts@workforce.local
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_USERNAME=
KEYCLOAK_SMTP_PASSWORD=
FRONTEND_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180
BACKEND_PORT=8080
FRONTEND_PORT=3000

MAX_DAILY_HOURS=24

# Local mock SAP token: generate a separate development-only secret.
SAP_API_TOKEN=
# Compose default is http://mock-sap:8090. Set an accessible URL when running backend outside Compose.
SAP_BASE_URL=http://mock-sap:8090
SAP_CONNECT_TIMEOUT=2s
SAP_RESPONSE_TIMEOUT=5s

# Same backend artifact: true enables worker in this process; false runs API only.
SAP_EXPORT_WORKER_ENABLED=true
SAP_EXPORT_BATCH_SIZE=5
SAP_EXPORT_POLL_INTERVAL=5s
SAP_EXPORT_MAX_ATTEMPTS=4
SAP_EXPORT_INITIAL_BACKOFF=30s
SAP_EXPORT_MAX_BACKOFF=10m
SAP_EXPORT_PROCESSING_TIMEOUT=5m
SAP_RECONCILIATION_INTERVAL=30s

# Maximum rows per report sheet (1-50000); narrow filters above this limit.
REPORT_MAX_DOWNLOAD_ROWS=10000

# Phase 7: local Mailpit only; no production email credentials.
APP_PUBLIC_BASE_URL=http://localhost:3000
WORKFORCE_BUSINESS_TIMEZONE=Europe/Athens
MAIL_FROM=noreply@workforce.local
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_EVALUATION_INTERVAL=PT15M
TIMESHEET_REMINDER_DAY_OF_MONTH=28
FINANCE_REMINDER_DAY_OF_MONTH=5
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_POLL_INTERVAL=PT5S
NOTIFICATION_PROCESSING_TIMEOUT=PT5M
NOTIFICATION_MAX_ATTEMPTS=4
NOTIFICATION_INITIAL_BACKOFF=PT30S
NOTIFICATION_MAX_BACKOFF=PT10M
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_CONNECT_TIMEOUT_MS=3000
MAIL_READ_TIMEOUT_MS=3000
MAIL_WRITE_TIMEOUT_MS=3000
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
# Phase 9: set true only after reviewing that ALL existing records belong to one legacy organization.
# Leave false for fresh databases. Do not use this to combine unrelated organizations.
LEGACY_TENANT_CONFIRMED=false
# Invitation delivery requires an independent random secret of at least 32 characters.
# Keep stable across backend instances/restarts. Rotation invalidates undelivered old links.
INVITATION_SIGNING_KEY=
INVITATION_VALIDITY=PT168H

# Per-backend-instance limits. Ingress/IP protection remains a deployment requirement.
API_MAX_REQUEST_BYTES=65536
API_SENSITIVE_REQUESTS_PER_MINUTE=60
