* text=auto
# Linux runtime inputs must survive Windows core.autocrlf checkouts unchanged.
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Caddyfile text eol=lf
*.sql text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.cmd text eol=crlf
# Preserve reviewed Go source/checksum bytes in reproducible runtime builds.
infra/production/caddy/** text eol=lf
infra/production/gosu/* text eol=lf
infra/production/keycloak-theme/** text eol=lf
