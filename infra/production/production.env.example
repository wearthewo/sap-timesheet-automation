# Non-secret settings only. Copy outside the repository; fill every placeholder.
APP_HOST=workforce.example.invalid
AUTH_HOST=identity.example.invalid
TLS_CONFIG=operator@example.invalid
SECRET_DIR=/etc/workforce/secrets
BACKUP_DIR=/var/backups/workforce
AGE_RECIPIENTS_FILE=/etc/workforce/backup-recipients.txt
# A private age key is required only for an explicitly approved restore.
AGE_IDENTITY_FILE=/etc/workforce/restore-key.txt
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
# Put the domain-scoped Resend sending API key in SECRET_DIR/SMTP_PASSWORD.
# Verify the sending domain first. Both Keycloak and Workforce share its quota.
MAIL_FROM=workforce@example.invalid
KEYCLOAK_ADMIN_USERNAME=REPLACE_WITH_PRIVATE_ADMIN_NAME
# Use a reviewed immutable release tag for application images.
RELEASE_TAG=REPLACE_WITH_REVIEWED_REVISION
PLATFORM=linux/amd64
PUBLIC_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
INGRESS_SUBNET=172.29.10.0/24
PROXY_IP=172.29.10.254
BACKUP_RETENTION_DAYS=14
