# Root-owned /etc/workforce/operations.env, mode 0600. systemd EnvironmentFile, not shell code.
BACKUP_DIR=/var/backups/workforce
BACKUP_TRANSPORT=b2
B2_RCLONE_CONFIG=/etc/workforce/offsite/rclone.conf
B2_DESTINATION=workforce-b2:REPLACE_WITH_PRIVATE_BUCKET/workforce
# Existing SSH transport remains supported; use BACKUP_TRANSPORT=ssh plus
# BACKUP_DESTINATION, BACKUP_SSH_IDENTITY, BACKUP_KNOWN_HOSTS, BACKUP_SSH_PORT.
# Private curl config: a separate external dead-man monitor; never an application SMTP dependency.
MONITOR_CURL_CONFIG=/etc/workforce/monitor-success.curl
